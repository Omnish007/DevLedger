{
    "shadow": {
        "xs": { "$type": "shadow", "$value": "0 1px 2px oklch(0.18 0.01 250 / 0.05)" },
        "sm": {
            "$type": "shadow",
            "$value": "0 1px 3px oklch(0.18 0.01 250 / 0.07), 0 1px 2px -1px oklch(0.18 0.01 250 / 0.05)"
        },
        "md": {
            "$type": "shadow",
            "$value": "0 6px 16px -4px oklch(0.18 0.01 250 / 0.08), 0 2px 6px -2px oklch(0.18 0.01 250 / 0.05)"
        },
        "popover": {
            "$type": "shadow",
            "$value": "0 16px 38px -10px oklch(0.14 0.01 250 / 0.24), 0 4px 12px -4px oklch(0.14 0.01 250 / 0.12)"
        },
        "modal": {
            "$type": "shadow",
            "$value": "0 24px 56px -12px oklch(0.12 0.01 250 / 0.34), 0 8px 20px -6px oklch(0.12 0.01 250 / 0.16)"
        }
    },
    "motion": {
        "duration-fast": { "$type": "duration", "$value": "120ms" },
        "duration-normal": { "$type": "duration", "$value": "180ms" },
        "duration-slow": { "$type": "duration", "$value": "260ms" },
        "ease-standard": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
}
