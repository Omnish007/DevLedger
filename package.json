{
  "name": "devledger-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A private, local-first workspace for software projects, developer operations and technical knowledge.",
  "author": "DevLedger",
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "tokens:build": "node scripts/build-tokens.mjs",
    "predev": "npm run tokens:build && npm run build:worker",
    "prebuild": "npm run tokens:build && npm run build:worker",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "shadcn:init": "shadcn init --base radix --yes --cwd .",
    "shadcn:add:required": "shadcn add accordion alert alert-dialog avatar badge breadcrumb button button-group calendar card checkbox collapsible command context-menu dialog drawer dropdown-menu empty field hover-card input input-group kbd label menubar native-select pagination popover progress radio-group resizable scroll-area select separator sheet sidebar skeleton slider sonner spinner switch table tabs textarea toggle toggle-group tooltip --yes --cwd .",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3 -w argon2",
    "package:linux": "npm run build && electron-builder --linux",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "build:worker": "tsc -p tsconfig.worker.json",
    "shadcn:check": "node scripts/check-shadcn-inventory.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:source": "node scripts/check-source-imports.mjs",
    "check:strip": "node scripts/check-node-strip-compat.mjs",
    "check:all": "npm run check:syntax && npm run check:source && npm run check:strip && npm run check:size && npm run shadcn:check && npm test && npm run test:performance && npm run tokens:build",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:performance": "node --experimental-strip-types --test tests/performance/*.test.ts",
    "check:size": "node scripts/check-source-size.mjs",
    "test:e2e:smoke": "npm run build && playwright test --grep @smoke",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:report": "playwright show-report playwright-report",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.27.0",
    "@tiptap/extension-list": "^3.27.0",
    "@tiptap/extension-mention": "^3.27.0",
    "@tiptap/extension-table": "^3.27.0",
    "@tiptap/markdown": "^3.27.0",
    "@tiptap/react": "^3.27.0",
    "@tiptap/starter-kit": "^3.27.0",
    "@tiptap/suggestion": "^3.27.0",
    "archiver": "^7.0.1",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.555.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "react-resizable-panels": "^4.24.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "unzipper": "^0.12.3",
    "vaul": "^1.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/unzipper": "^0.10.10",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.6.2",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "com.devledger.desktop",
    "productName": "DevLedger",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "extraMetadata": {
      "main": "out/main/index.cjs"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2"
}
